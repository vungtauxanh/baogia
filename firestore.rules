rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: folders
    // Document ID: auto-generated
    // Fields:
    //   - name: string (required, max 100 chars)
    //   - userId: string (required, immutable)
    //   - createdAt: timestamp (required, immutable)
    //
    // Collection: documents
    // Document ID: auto-generated
    // Fields:
    //   - title: string (required, max 200 chars)
    //   - date: string (required, max 50 chars)
    //   - type: string (required, 'quotation' or 'handover')
    //   - folderId: string (optional, max 100 chars)
    //   - userId: string (required, immutable)
    //   - data: string (required, max 1000000 chars - JSON payload)
    //   - createdAt: timestamp (required, immutable)
    //
    // Collection: profiles
    // Document ID: auto-generated
    // Fields:
    //   - profileName: string (required, max 100 chars)
    //   - userId: string (required, immutable)
    //   - data: string (required, max 1000000 chars - JSON payload)
    //   - createdAt: timestamp (required, immutable)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.userId;
    }

    function uidUnchanged() {
      return !('userId' in request.resource.data) || request.resource.data.userId == request.auth.uid;
    }

    function uidNotModified() {
      return !('userId' in request.resource.data) || request.resource.data.userId == resource.data.userId;
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function validStringLength(field, minLen, maxLen) {
      return request.resource.data[field] is string &&
        request.resource.data[field].size() >= minLen &&
        request.resource.data[field].size() <= maxLen;
    }

    function isValidOptionalString(field, minLen, maxLen) {
      return !(field in request.resource.data) ||
             (request.resource.data[field] is string &&
              request.resource.data[field].size() >= minLen &&
              request.resource.data[field].size() <= maxLen);
    }

    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================
    function isValidFolder() {
      return hasOnlyAllowedFields(['name', 'userId', 'createdAt']) &&
             validStringLength('name', 1, 100) &&
             request.resource.data.userId is string &&
             request.resource.data.createdAt is timestamp;
    }

    function isValidDocument() {
      return hasOnlyAllowedFields(['title', 'date', 'type', 'folderId', 'userId', 'data', 'createdAt']) &&
             validStringLength('title', 1, 200) &&
             validStringLength('date', 1, 50) &&
             request.resource.data.type in ['quotation', 'handover'] &&
             isValidOptionalString('folderId', 1, 100) &&
             request.resource.data.userId is string &&
             validStringLength('data', 1, 1000000) &&
             request.resource.data.createdAt is timestamp;
    }

    function isValidProfile() {
      return hasOnlyAllowedFields(['profileName', 'userId', 'data', 'createdAt']) &&
             validStringLength('profileName', 1, 100) &&
             request.resource.data.userId is string &&
             validStringLength('data', 1, 1000000) &&
             request.resource.data.createdAt is timestamp;
    }

    // ===============================================================
    // Rules
    // ===============================================================
    match /folders/{folderId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && 
                    isValidFolder() && 
                    request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && 
                    isDocOwner() && 
                    isValidFolder() && 
                    areImmutableFieldsUnchanged(['userId', 'createdAt']);
      allow delete: if isAuthenticated() && isDocOwner();
    }

    match /documents/{documentId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && 
                    isValidDocument() && 
                    request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && 
                    isDocOwner() && 
                    isValidDocument() && 
                    areImmutableFieldsUnchanged(['userId', 'createdAt']);
      allow delete: if isAuthenticated() && isDocOwner();
    }

    match /profiles/{profileId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && 
                    isValidProfile() && 
                    request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && 
                    isDocOwner() && 
                    isValidProfile() && 
                    areImmutableFieldsUnchanged(['userId', 'createdAt']);
      allow delete: if isAuthenticated() && isDocOwner();
    }
  }
}
